---
/**
 * HeroDots: トップページのヒーローに表示するドットの3Dジオラマ。
 * Minecraft 風の「ブロックで組んだ家と、正面を向いて座るねこ」を
 * ボクセル点群で描き、台座ごとゆっくり回転させる。
 *
 * 見え方のポイント:
 *   - すべて中まで詰まった塊(壁厚2の家、充実の屋根)でシルエットを作る
 *   - ドット径を 0.9 にして隣とほぼ密着させ、面として読ませる
 *   - depthWrite を有効にして手前のドットで奥を隠す(透過しない)
 *
 * 色はすべてデザイントークンから取得するので、global.css の @theme を
 * 変更するとこのグラフィックにも反映される。
 *
 * パレット対応:
 *   地面      --color-border-strong(薄いグレー)
 *   壁・煙突  --color-foreground-3(中間グレー)
 *   屋根      --color-foreground-2(濃いグレー)
 *   ねこ      --color-foreground(インク)
 *   窓・目・毛糸玉・屋根の棟・ハート --color-accent(インディゴ)
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["pointer-events-none select-none", className]} data-hero-dots aria-hidden="true">
</div>

<style>
  [data-hero-dots] {
    /* キャンバスの端を背景に溶かす */
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 55%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 55%, transparent 100%);
  }
</style>

<script>
  import * as THREE from "three";
  import { buildDiorama, type DioramaColor } from "../lib/diorama";

  const container = document.querySelector<HTMLElement>("[data-hero-dots]");
  if (!container) throw new Error("HeroDots: container not found");

  // デザイントークンから色を取得
  const styles = getComputedStyle(document.documentElement);
  const token = (name: string, fallback: string) =>
    new THREE.Color(styles.getPropertyValue(name).trim() || fallback);

  const palette: Record<DioramaColor, THREE.Color> = {
    floor: token("--color-border-strong", "#d6d3d1"),
    wall: token("--color-foreground-3", "#78716c"),
    roof: token("--color-foreground-2", "#57534e"),
    cat: token("--color-foreground", "#1c1917"),
    accent: token("--color-accent", "#4f46e5"),
  };

  // ===== 点群の構築 =====
  const voxels = buildDiorama();

  const positions = new Float32Array(voxels.length * 3);
  const colors = new Float32Array(voxels.length * 3);
  voxels.forEach(([x, y, z, key], i) => {
    positions[i * 3] = x;
    positions[i * 3 + 1] = y;
    positions[i * 3 + 2] = z;
    const c = palette[key];
    colors[i * 3] = c.r;
    colors[i * 3 + 1] = c.g;
    colors[i * 3 + 2] = c.b;
  });

  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute("color", new THREE.BufferAttribute(colors, 3));

  // ドットは隣とほぼ密着させ、面として読ませる。奥は手前で隠す。
  const material = new THREE.PointsMaterial({
    size: 0.9,
    vertexColors: true,
    sizeAttenuation: true,
  });

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setClearColor(0x000000, 0);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  container.appendChild(renderer.domElement);

  const canvas = renderer.domElement;
  canvas.style.display = "block";
  canvas.style.width = "100%";
  canvas.style.height = "100%";

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
  camera.position.set(0, 2.5, 22);
  camera.lookAt(0, 1.5, 0);

  const group = new THREE.Group();
  group.add(new THREE.Points(geometry, material));
  // ジオラマの中心を原点に合わせる
  group.position.set(-12.5, -6.5, -7.5);
  group.rotation.x = 0.08;
  group.scale.setScalar(0.95);
  scene.add(group);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const resize = () => {
    const width = container.clientWidth || 1;
    const height = container.clientHeight || 1;
    renderer.setSize(width, height, false);
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
  };
  const observer = new ResizeObserver(resize);
  observer.observe(container);
  resize();

  // マウス視差
  let mouseX = 0;
  let mouseY = 0;
  window.addEventListener(
    "pointermove",
    (event) => {
      mouseX = (event.clientX / window.innerWidth - 0.5) * 2;
      mouseY = (event.clientY / window.innerHeight - 0.5) * 2;
    },
    { passive: true },
  );

  const clock = new THREE.Clock();
  let frame = 0;

  const animate = () => {
    frame = requestAnimationFrame(animate);
    const dt = Math.min(clock.getDelta(), 0.1);
    group.rotation.y += dt * 0.25;
    group.rotation.x += (0.08 + mouseY * 0.12 - group.rotation.x) * 0.04;
    group.rotation.z += (-mouseX * 0.12 - group.rotation.z) * 0.04;
    renderer.render(scene, camera);
  };

  if (reduceMotion) {
    renderer.render(scene, camera);
  } else {
    animate();
  }

  // タブ非表示中は描画を止める
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      if (!reduceMotion) cancelAnimationFrame(frame);
    } else if (!reduceMotion) {
      clock.getDelta();
      animate();
    }
  });
</script>
