---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label="タグ">
      {tags.map((tag) => (
        <li class="rounded-full bg-accent-tint px-2.5 py-0.5 text-xs font-medium text-accent">
          {tag}
        </li>
      ))}
    </ul>
  )
}
