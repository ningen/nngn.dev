---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";
import { formatDate, formatISO } from "../lib/format";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;
---

<article
  class="group rounded-lg border border-border bg-surface p-5 transition-colors hover:border-border-strong hover:shadow-sm"
>
  <time class="font-mono text-xs text-foreground-3" datetime={formatISO(date)}>
    {formatDate(date)}
  </time>
  <h2 class="mt-1.5 text-lg font-bold tracking-tight">
    <a href={`/blog/${post.id}/`} class="transition-colors group-hover:text-accent">
      {title}
    </a>
  </h2>
  <p class="mt-1.5 text-sm leading-relaxed text-foreground-2">{description}</p>
  <div class="mt-3">
    <TagList tags={tags} />
  </div>
</article>
