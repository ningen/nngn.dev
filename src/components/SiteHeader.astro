---
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "トップ", active: path === "/" },
  { href: "/blog/", label: "Blog", active: path.startsWith("/blog") },
];
---

<header class="sticky top-0 z-10 border-b border-border bg-background/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-3.5">
    <a href="/" class="flex items-center gap-2 font-mono text-base font-medium tracking-tight">
      <img src="/favicon.svg" alt="" width="22" height="22" class="shrink-0" />
      <span>nngn<span class="text-accent">.dev</span></span>
    </a>
    <nav class="flex items-center gap-1" aria-label="メインナビゲーション">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-sm px-3 py-1.5 text-sm transition-colors",
              item.active
                ? "font-medium text-foreground underline decoration-accent decoration-2 underline-offset-8"
                : "text-foreground-2 hover:text-foreground",
            ]}
            aria-current={item.active ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
