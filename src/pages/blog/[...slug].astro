---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogProse from "../../components/BlogProse.astro";
import TagList from "../../components/TagList.astro";
import { formatDate, formatISO } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-6 py-12">
    <header class="border-b border-border pb-8">
      <div class="flex items-center gap-3">
        <time
          class="font-mono text-sm text-foreground-3"
          datetime={formatISO(post.data.date)}
        >
          {formatDate(post.data.date)}
        </time>
        <a
          href="/blog/"
          class="font-mono text-xs text-accent transition-colors hover:text-accent-hover"
        >
          ← Blog
        </a>
      </div>
      <h1 class="mt-3 text-3xl font-bold leading-snug tracking-tight">
        {post.data.title}
      </h1>
      <p class="mt-3 leading-relaxed text-foreground-2">{post.data.description}</p>
      <div class="mt-4">
        <TagList tags={post.data.tags} />
      </div>
    </header>
    <BlogProse class="mx-auto mt-8 max-w-2xl">
      <Content />
    </BlogProse>
  </article>
</BaseLayout>
